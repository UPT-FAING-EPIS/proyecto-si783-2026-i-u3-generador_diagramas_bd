{
  "name": "fluxsql-agent",
  "version": "0.1.0",
  "private": true,
  "description": "FluxSQL monorepo for web, desktop, cloud API and local sidecar.",
  "scripts": {
    "dev:web": "pnpm --filter @fluxsql/web dev",
    "dev:api": "pnpm --filter @fluxsql/api dev",
    "dev:desktop": "pnpm --filter @fluxsql/desktop desktop:dev",
    "dev:local-sidecar": "python apps/desktop/backend-python/main.py",
    "build:web": "pnpm --filter @fluxsql/web build",
    "build:api": "pnpm --filter @fluxsql/api build",
    "build:desktop": "pnpm --filter @fluxsql/desktop desktop:build",
    "lint:web": "pnpm --filter @fluxsql/web lint",
    "lint:api": "pnpm --filter @fluxsql/api lint",
    "typecheck": "pnpm --recursive --if-present run lint",
    "mcp:desktop": "node scripts/fluxsql-mcp-stdio.mjs",
    "verify:mvp": "powershell -ExecutionPolicy Bypass -File scripts/verify-mvp.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0"
}
