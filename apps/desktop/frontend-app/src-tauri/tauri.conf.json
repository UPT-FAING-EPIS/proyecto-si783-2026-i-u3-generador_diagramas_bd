{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FluxSQL",
  "version": "0.1.0",
  "identifier": "com.fluxsql.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3002",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FluxSQL",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../../scripts/fluxsql-mcp-stdio.mjs"
    ],
    "externalBin": [
      "binaries/fluxsql-sidecar"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
